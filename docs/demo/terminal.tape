# Terminal settings shared by every recording. Source this first, then one
# of light.tape or dark.tape, then enter.tape.
# zsh, not bash: macOS's bash 3.2 sometimes prints "child setpgid ...:
# Operation not permitted" when starting a command under VHS.
Set Shell "zsh"
Set FontFamily "Menlo"
Set LineHeight 1.25
Set Padding 28
Set Margin 36
Set WindowBar Colorful
Set BorderRadius 12
Set TypingSpeed 45ms
