# Dark theme in the brand palette: warm charcoal with cream text. The margin
# matches GitHub's dark background, so the window floats on the page.
Set MarginFill "#0D1117"
Set Theme { "name": "Clonetree dark", "background": "#1B1714", "foreground": "#F1E6CF", "cursor": "#7D9473", "selection": "#3A322C", "black": "#2B2420", "red": "#D9534F", "green": "#7D9473", "yellow": "#D2551F", "blue": "#7891AD", "magenta": "#A985A4", "cyan": "#79A6A1", "white": "#DFDCD4", "brightBlack": "#A39686", "brightRed": "#E46B5D", "brightGreen": "#9CB592", "brightYellow": "#E07A45", "brightBlue": "#93A9C2", "brightMagenta": "#C0A0BB", "brightCyan": "#94BDB8", "brightWhite": "#F8F7F3" }
