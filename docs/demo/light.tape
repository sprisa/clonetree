# Light theme in the brand palette (docs/BRANDING.md): warm white background,
# ink text, sage and burnt orange accents.
Set MarginFill "#E9E5DC"
Set Theme { "name": "Clonetree", "background": "#F8F7F3", "foreground": "#4B3C32", "cursor": "#65745D", "selection": "#E3E8DF", "black": "#4B3C32", "red": "#C0504D", "green": "#65745D", "yellow": "#B07D48", "blue": "#5D7590", "magenta": "#8F6A8A", "cyan": "#5E8B87", "white": "#DFDCD4", "brightBlack": "#806B58", "brightRed": "#D9534F", "brightGreen": "#7D9473", "brightYellow": "#D2551F", "brightBlue": "#7891AD", "brightMagenta": "#A985A4", "brightCyan": "#79A6A1", "brightWhite": "#F8F7F3" }
